  --red:#d5001c; --soft:#ececea; --dark:#171717;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif}
.app{max-width:1500px;margin:auto}
.topbar{height:68px;background:#050505;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 34px;letter-spacing:.04em}
.brand{font-weight:800;letter-spacing:.28em;font-size:17px}
.badge{font-size:11px;color:#aaa;text-transform:uppercase;letter-spacing:.16em}
.hero{padding:30px 34px 18px;background:#fff;border-bottom:1px solid var(--line)}
.kicker{font-size:10px;text-transform:uppercase;letter-spacing:.2em;color:#777;margin-bottom:8px}
h1{font-size:34px;margin:0 0 8px;font-weight:500;letter-spacing:-.03em}
.subtitle{color:#666;font-size:13px}
.filters{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:18px 34px;background:#fff;border-bottom:1px solid var(--line)}
.filter label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.14em;color:#777;margin-bottom:7px}
select{width:100%;height:40px;border:1px solid #ccc;background:#fafafa;padding:0 11px;color:#111;border-radius:0}
main{padding:22px 34px 40px}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.card{background:var(--panel);border:1px solid var(--line);padding:18px}
.kpi-label{font-size:10px;text-transform:uppercase;letter-spacing:.15em;color:#777}
.kpi-value{font-size:28px;margin-top:10px;letter-spacing:-.04em}
.kpi-note{font-size:11px;color:#888;margin-top:5px}
.grid{display:grid;grid-template-columns:1.25fr .75fr;gap:18px;margin-bottom:18px}
.panel{background:#fff;border:1px solid var(--line);padding:20px}
.panel-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:16px}
.panel-title{font-size:15px;font-weight:600}
.panel-q{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#999;margin-top:5px}
.chart-wrap{height:300px;position:relative}
.insights{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.insight{background:#111;color:#fff;padding:18px;min-height:150px}
.insight .tag{font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#aaa}
.insight h3{font-size:16px;font-weight:500;margin:12px 0 8px}
.insight p{font-size:12px;line-height:1.5;color:#ccc;margin:0}
.redline{width:34px;height:3px;background:var(--red);margin:12px 0}
.footer{font-size:10px;color:#888;padding:0 34px 24px}
@media(max-width:900px){.filters,.kpis{grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr}.insights{grid-template-columns:1fr}}
@media(max-width:560px){.filters,.kpis{grid-template-columns:1fr}.topbar,.hero,main,.footer{padding-left:18px;padding-right:18px}}
</style>
<style>.cover{position:relative;height:420px;overflow:hidden;background:linear-gradient(90deg,rgba(0,0,0,.88),rgba(0,0,0,.1)),url('https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=2200&q=90') center/cover;color:#fff;display:flex;align-items:flex-end;padding:48px 52px}.cover-content{max-width:680px}.cover-eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.28em;color:#ddd;margin-bottom:14px}.cover h2{margin:0;font-size:52px;font-weight:300;letter-spacing:-.045em}.cover p{margin:12px 0 0;color:#ddd;font-size:14px}.cover-line{width:54px;height:3px;background:#d5001c;margin-top:20px}.powerbi-strip{background:#252423;color:#fff;height:38px;display:flex;align-items:center;padding:0 34px;font-size:10px;letter-spacing:.16em;text-transform:uppercase}.card,.panel{box-shadow:0 1px 3px rgba(0,0,0,.06)}</style></head>
