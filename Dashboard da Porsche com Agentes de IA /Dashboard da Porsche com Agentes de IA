let cityChart, yearChart, paymentChart;

const fmtBRL = n => n.toLocaleString('pt-BR', {style:'currency',currency:'BRL',maximumFractionDigits:0});
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));

function filtered() {
  const m=document.getElementById('model').value, y=document.getElementById('year').value,
        c=document.getElementById('city').value, p=document.getElementById('payment').value;
  return DATA.filter(d =>
    (m==='ALL'||d.model===m) && (y==='ALL'||String(d.year)===y) &&
    (c==='ALL'||d.city===c) && (p==='ALL'||d.payment===p)
  );
}

function aggregate(arr,key) {
  const o={}; arr.forEach(d=>o[d[key]]=(o[d[key]]||0)+1); return o;
}

function refresh() {
  const d=filtered();
  const sales=d.length, revenue=d.reduce((s,x)=>s+x.price,0);
  document.getElementById('kpiSales').textContent=sales.toLocaleString('pt-BR');
  document.getElementById('kpiRevenue').textContent=fmtBRL(revenue);
  document.getElementById('kpiTicket').textContent=fmtBRL(sales?revenue/sales:0);

  const models=aggregate(d,'model');
  const leader=Object.entries(models).sort((a,b)=>b[1]-a[1])[0];
  document.getElementById('kpiLeader').textContent=leader?leader[0]:'—';
  document.getElementById('kpiLeaderNote').textContent=leader?`${leader[1]} venda(s) no recorte`:'sem dados';

  // City x top models: show top 5 cities and their most popular model
  const cityModel={};
  d.forEach(x=>{cityModel[x.city]??={};cityModel[x.city][x.model]=(cityModel[x.city][x.model]||0)+1});
  const cityRows=Object.entries(cityModel).map(([city,mods])=>{
    const top=Object.entries(mods).sort((a,b)=>b[1]-a[1])[0];
    return [city,top[0],top[1],Object.values(mods).reduce((a,b)=>a+b,0)];
  }).sort((a,b)=>b[3]-a[3]).slice(0,8);

  const labels=cityRows.map(x=>x[0]);
  const vals=cityRows.map(x=>x[2]);
  if(cityChart) cityChart.destroy();
  cityChart=new Chart(document.getElementById('cityChart'),{type:'bar',data:{labels,datasets:[{label:'Vendas do modelo líder',data:vals,borderWidth:0,backgroundColor:'#171717'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{afterLabel:(ctx)=>'Modelo: '+cityRows[ctx.dataIndex][1]}}},scales:{x:{grid:{display:false}},y:{beginAtZero:true,ticks:{precision:0}}}}});

  const years=aggregate(d,'year');
  const yrows=Object.entries(years).filter(x=>x[0]!=='null').sort((a,b)=>Number(a[0])-Number(b[0]));
  if(yearChart) yearChart.destroy();
  yearChart=new Chart(document.getElementById('yearChart'),{type:'doughnut',data:{labels:yrows.map(x=>x[0]),datasets:[{data:yrows.map(x=>x[1]),backgroundColor:['#171717','#555','#888','#bbb','#d5001c','#ddd'],borderWidth:2,borderColor:'#fff'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{boxWidth:10,font:{size:10}}}}}});

  const pays=aggregate(d,'payment');
  if(paymentChart) paymentChart.destroy();
  paymentChart=new Chart(document.getElementById('paymentChart'),{type:'bar',data:{labels:Object.keys(pays),datasets:[{data:Object.values(pays),backgroundColor:'#555',borderWidth:0}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{beginAtZero:true,ticks:{precision:0}},y:{grid:{display:false}}}}});

  const insightBox=document.getElementById('insights');
  insightBox.innerHTML='';
  const cities=Object.entries(cityModel).sort((a,b)=>Object.values(b[1]).reduce((x,y)=>x+y,0)-Object.values(a[1]).reduce((x,y)=>x+y,0)).slice(0,3);
  if(!cities.length) {
    insightBox.innerHTML='<div class="insight"><div class="tag">Sem dados</div><h3>Ajuste os filtros</h3><p>Não há vendas para a combinação selecionada.</p></div>';
  } else {
    cities.forEach(([city,mods],i)=>{
      const top=Object.entries(mods).sort((a,b)=>b[1]-a[1])[0];
      const total=Object.values(mods).reduce((a,b)=>a+b,0);
      const share=Math.round(top[1]/total*100);
      insightBox.innerHTML += `<div class="insight"><div class="tag">Cidade · ${i+1}</div><div class="redline"></div><h3>${esc(city)} — ${esc(top[0])}</h3><p>${top[1]} de ${total} vendas da cidade pertencem ao modelo líder, representando ${share}% do volume local.</p></div>`;
    });
  }
}

document.querySelectorAll('select').forEach(x=>x.addEventListener('change',refresh));
refresh();
